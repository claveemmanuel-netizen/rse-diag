# ─── Application (front) ─────────────────────────────────────────────────────
# Ces variables sont embarquées dans le front : n'y mettez JAMAIS de clé secrète.
# Laisser vide = mode local (démonstration, sans serveur ni authentification réelle).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Active le bouton « Générer le brouillon du diagnostic » (nécessite la fonction Edge ci-dessous).
VITE_FEATURE_BROUILLON_IA=false

# Boutons « 🧪 test » qui pré-remplissent la visite avec des données fictives (démonstration, recette).
# Toujours affichés en mode local (sans Supabase) ; avec un vrai serveur, mettre true seulement sur un environnement de test.
VITE_FEATURE_DONNEES_TEST=false

# Informations de l'entreprise (en-tête du pré-rapport PDF, mention RGPD). Pas des secrets : visibles dans le front.
VITE_ENTREPRISE_NOM=
VITE_ENTREPRISE_ADRESSE=
VITE_ENTREPRISE_TELEPHONE=
VITE_ENTREPRISE_EMAIL=
VITE_ENTREPRISE_SITE=
# Adresse d'exercice des droits RGPD (par défaut : VITE_ENTREPRISE_EMAIL).
VITE_ENTREPRISE_EMAIL_RGPD=

# ─── Fonction Edge Supabase « brouillon-diagnostic » (SERVEUR UNIQUEMENT) ────
# À déclarer avec : supabase secrets set LLM_API_KEY=... (jamais dans le front, jamais préfixé VITE_).
# Ces lignes sont documentaires : elles ne sont lues que par la fonction Edge hébergée chez Supabase.
# FEATURE_BROUILLON_IA=true
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
